# Runtime env for the test deploy (test.bitba.ng → signaling-test.service).
# Copied to .env on the server by upload_test.

# Port the reverse proxy expects (matches what signaling-test.service
# was previously running Python on — change here AND in the proxy config
# if you want to move it).
PORT=8081

# Static assets shipped alongside the binary by upload_test.
STATIC_DIR=/opt/bitbang-test/signaling

# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# coturn config — set on the server if you want TURN. Leave blank to run
# TURN-disabled (devices must supply their own ice_servers).
# COTURN_HOST=
# COTURN_SECRET=
# COTURN_TTL=86400
# TURN_MAX_ACTIVE=0
