#!/bin/bash
# Test-deploy the Go signaling server to /opt/bitbang-test/ on the remote
# host (signaling-test.service, fronted by test.bitba.ng).
#
# Ships: signaling-go binary, signaling/ static assets, .env, and the
# systemd unit (replaces in place if changed).
set -euo pipefail

source .env

SRC=signaling-go
STATIC=signaling
TARFILE=signaling-test.tgz
REMOTE_DIR=/opt/bitbang-test
SERVICE=signaling-test.service

# Cross-compile for linux/amd64. Static binary, no CGo, no runtime deps.
echo "Building signaling-go for linux/amd64..."
(cd ${SRC} && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o signaling-go ./cmd/signaling)

# Static files served by the Go binary (matches the asset types the
# previous upload_test shipped, minus *.py / *.sh which we don't need).
STATIC_FILES=$(find ${STATIC} -type f \( \
    -wholename "*.html" -o \
    -wholename "*.png" -o \
    -wholename "*.ico" -o \
    -wholename "*.jpg" -o \
    -wholename "*.js" \
\))

tar cvfz ${TARFILE} \
    ${SRC}/signaling-go \
    ${SRC}/.env_test \
    ${SRC}/${SERVICE} \
    ${STATIC_FILES}

scp -i ${SERVER_SSH_KEY} ${TARFILE} ${SERVER_SSH}:${REMOTE_DIR}/${TARFILE}

ssh ${SERVER_SSH} -i ${SERVER_SSH_KEY} "
    set -e
    cd ${REMOTE_DIR}
    tar xvfz ${TARFILE}

    # Flatten binary, env, and service file to the deploy root so the
    # systemd unit's paths (/opt/bitbang-test/...) resolve.
    mv ${SRC}/signaling-go ./signaling-go
    cp ${SRC}/.env_test ./.env
    cp ${SRC}/${SERVICE} ./${SERVICE}

    # Install/update the systemd unit if it's missing or different.
    if ! sudo cmp -s ${SERVICE} /etc/systemd/system/${SERVICE}; then
        echo 'Installing/updating systemd unit'
        sudo cp ${SERVICE} /etc/systemd/system/${SERVICE}
        sudo systemctl daemon-reload
        sudo systemctl enable ${SERVICE}
    fi

    sudo systemctl restart ${SERVICE}
    sleep 0.5
    sudo systemctl --no-pager --lines=10 status ${SERVICE} || true
"

PORT=$(grep '^PORT=' ${SRC}/.env_test | cut -d= -f2)
echo
echo "Deployed. /status:"
ssh ${SERVER_SSH} -i ${SERVER_SSH_KEY} "curl -s http://localhost:${PORT}/status" || true
echo
