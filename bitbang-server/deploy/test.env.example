# Runtime env shipped to test (test.bitba.ng -> signaling-test.service).
# Copy to test.env and fill in secrets. upload_test then ships test.env
# to /opt/bitbang-test/.env on the remote.

BITBANG_SERVER_PORT=8082
STATIC_DIR=/opt/bitbang-test/web
LOG_LEVEL=INFO

# Test also runs behind nginx — honor X-Real-IP (only) so browser_ip
# and rate-limiter keys are the real client IP. See handler.clientIP.
TRUST_PROXY_HEADERS=true

# When set, /status requires "Authorization: Bearer <token>" from anywhere
# but loopback -- it otherwise exposes live device counts and connection
# totals to anyone. Empty leaves it public.
#
# Loopback is exempt so `upload_production` can keep reading /status over
# ssh. That exemption goes through the real client IP, not the socket's,
# so nginx running on the same host does not launder the internet into
# looking local.
#
#   curl -H "Authorization: Bearer $TOKEN" https://bitba.ng/status
#
# Generate one with: openssl rand -hex 24
STATUS_TOKEN=

# Coturn (TURN) configuration. COTURN_SECRET is sensitive; do not commit.
# Shorter TTL and smaller cap than production make the end-of-session
# and capacity-gate UX exercisable in real time.
COTURN_HOST=turn.example.com
COTURN_SECRET=
COTURN_TTL=300
TURN_MAX_ACTIVE=2

# Periodic SQLite snapshot of /status counters; counters resume across
# restarts. Shorter interval than production so the write/load cycle is
# exercisable in observable time on a test box. See
# production.env.example for the full explanation and inspection tips.
METRICS_PATH=/opt/bitbang-test/metrics.db
METRICS_INTERVAL=60

# /install redirect target — see production.env.example for the
# semantics. Empty means /install returns 404.
INSTALL_URL=

# HTML snippet spliced into the entry page — see production.env.example
# for the contract. upload_test ships deploy/test.front.html here.
FRONT_PAGE_PATH=/opt/bitbang-test/front.html
