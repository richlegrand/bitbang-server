# Runtime env shipped to test (test.bitba.ng -> signaling-test.service).
# Copy to test.env and fill in secrets. upload_test then ships test.env
# to /opt/bitbang-test/.env on the remote.

BITBANG_SERVER_PORT=8082
STATIC_DIR=/opt/bitbang-test/web
LOG_LEVEL=INFO

# Test also runs behind nginx — honor X-Real-IP (only) so browser_ip
# and rate-limiter keys are the real client IP. See handler.clientIP.
TRUST_PROXY_HEADERS=true

# Coturn (TURN) configuration. COTURN_SECRET is sensitive; do not commit.
# Shorter TTL and smaller cap than production make the end-of-session
# and capacity-gate UX exercisable in real time.
COTURN_HOST=turn.example.com
COTURN_SECRET=
COTURN_TTL=300
TURN_MAX_ACTIVE=2
