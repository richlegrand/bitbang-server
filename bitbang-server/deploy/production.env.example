# Runtime env shipped to production (bitba.ng -> signaling.service).
# Copy to production.env and fill in secrets. upload_production then
# ships production.env to /opt/bitbang/.env on the remote.

BITBANG_SERVER_PORT=8081
STATIC_DIR=/opt/bitbang/web
LOG_LEVEL=INFO

# Production runs behind nginx, which sets X-Real-IP from the TCP-level
# remote address. Honor that header (and only that header — XFF is
# intentionally ignored; see handler.clientIP) so browser_ip and
# rate-limiter keys are the real client IP rather than nginx's loopback.
TRUST_PROXY_HEADERS=true

# Coturn (TURN) configuration. COTURN_SECRET is sensitive; do not commit.
COTURN_HOST=turn.example.com
COTURN_SECRET=
COTURN_TTL=3600
TURN_MAX_ACTIVE=0

# Periodic SQLite snapshot of /status counters. Each tick inserts one row
# into a snapshots table: (ts, devices, clients, connection_requests_total,
# ...). Disabled when METRICS_PATH is empty.
#
# Counters resume across restarts: at startup the server reads the most-
# recent row, seeds the in-memory atomics, writes a fresh row reflecting
# the seeded state, and then takes over with periodic ticks. At most one
# interval's worth of un-flushed events is lost on a hard crash.
#
# Schema and PRAGMAs (WAL mode, synchronous=NORMAL) are applied
# automatically on first open. No setup required.
#
# Storage budget at the default 5-minute interval: ~30 MB/year. SQLite
# WAL auto-checkpoints; no VACUUM scheduling needed for normal operation.
#
# Inspect from the shell with either `sqlite3 /opt/bitbang/metrics.db`
# (requires apt install sqlite3) or the bundled bitbang-metrics-dump
# tool: `bitbang-metrics-dump | jq .` for the latest row, or
# `bitbang-metrics-dump -history 100 | jq .` for the last 100 rows.
METRICS_PATH=/opt/bitbang/metrics.db
METRICS_INTERVAL=300
