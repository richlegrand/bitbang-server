# Runtime env shipped to production (bitba.ng -> signaling.service).
# Copy to production.env and fill in secrets. upload_production then
# ships production.env to /opt/bitbang/.env on the remote.

BITBANG_SERVER_PORT=8081
STATIC_DIR=/opt/bitbang/web
LOG_LEVEL=INFO

# Production runs behind nginx, which sets X-Real-IP / X-Forwarded-For and
# strips client-supplied values. Honor those headers when stamping
# browser_ip on relayed connection requests so devices see the real
# client IP rather than nginx's loopback address.
TRUST_PROXY_HEADERS=true

# Coturn (TURN) configuration. COTURN_SECRET is sensitive; do not commit.
COTURN_HOST=turn.example.com
COTURN_SECRET=
COTURN_TTL=3600
TURN_MAX_ACTIVE=0
