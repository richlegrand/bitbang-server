#!/bin/bash
# upload_test - build, ship, and restart the signaling server on the
# test host.
#
# Reads deploy/test.deploy for SSH config (local, never ships).
# Ships:   ./signaling-go (compiled), deploy/test.env (-> .env on
#          remote), deploy/signaling-test.service, web/.
# Restarts signaling-test.service on the remote.
set -euo pipefail

# Run from repo root (parent of deploy/).
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "${ROOT}"

source deploy/test.deploy

echo "Building signaling-go for linux/amd64..."
CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o signaling-go ./cmd/signaling

TARFILE=signaling-test.tgz
SERVICE=signaling-test.service

tar cvfz "${TARFILE}" \
    signaling-go \
    deploy/test.env \
    deploy/test.front.html \
    deploy/"${SERVICE}" \
    web

scp -i "${SERVER_SSH_KEY}" "${TARFILE}" "${SERVER_SSH}:${SERVER_SSH_DIR}/${TARFILE}"

ssh "${SERVER_SSH}" -i "${SERVER_SSH_KEY}" "
    set -e
    cd ${SERVER_SSH_DIR}
    tar xvfz ${TARFILE}

    cp deploy/test.env .env
    cp deploy/test.front.html front.html
    cp deploy/${SERVICE} ${SERVICE}

    systemctl --user restart ${SERVICE}
    sleep 0.5
    systemctl --user --no-pager --lines=10 status ${SERVICE} || true
"

PORT=$(grep '^BITBANG_SERVER_PORT=' deploy/test.env | cut -d= -f2)
echo
echo "Deployed. /status:"
ssh "${SERVER_SSH}" -i "${SERVER_SSH_KEY}" "curl -s http://localhost:${PORT}/status" || true
echo
